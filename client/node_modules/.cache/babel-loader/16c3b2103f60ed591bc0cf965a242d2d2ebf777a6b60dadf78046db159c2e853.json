ourcesContent":["\"use client\"\n\nimport React, { memo, useEffect, useState } from \"react\"\n\nexport const AuroraText = memo(({ children, className = \"\", colors, speed = 1 }) => {\n  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false)\n\n  useEffect(() => {\n    const mediaQuery = window.matchMedia(\"(prefers-reduced-motion: reduce)\")\n    setPrefersReducedMotion(mediaQuery.matches)\n\n    const handler = (event) => setPrefersReducedMotion(event.matches)\n    mediaQuery.addEventListener(\"change\", handler)\n    return () => mediaQuery.removeEventListener(\"change\", handler)\n  }, [])\n\n  const defaultColors = [\"#2563eb\", \"#0ea5e9\", \"#06b6d4\", \"#22d3ee\"]\n  const colorArray = colors && colors.length > 0 ? colors : defaultColors\n\n  const gradientStyle = {\n    backgroundImage: `linear-gradient(135deg, ${colorArray.join(\", \")}, ${colorArray[0]})`,\n    WebkitBackgroundClip: \"text\",\n    WebkitTextFillColor: \"transparent\",\n    backgroundClip: \"text\",\n    animationDuration: prefersReducedMotion ? \"0.01ms\" : `${10 / speed}s`,\n    animationPlayState: prefersReducedMotion ? \"paused\" : \"running\",\n  }\n\n  return (\n    <span className={`relative inline-block ${className}`}>\n      <span className=\"visually-hidden\">{children}</span>\n      <span\n        className=\"animate-aurora\"\n        style={gradientStyle}\n        aria-hidden=\"true\"\n      >\n        {children}\n      </span>\n    </span>\n  )\n})\n\nAuroraText.displayName = \"AuroraText\""],"mappings":"AAAA,YAAY,CAEZ,MAAO,CAAAA,KAAK,EAAIC,IAAI,CAAEC,SAAS,CAAEC,QAAQ,KAAQ,OAAO,QAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAExD,MAAO,MAAM,CAAAC,UAAU,cAAGP,IAAI,CAAC,CAAC,CAAEQ,QAAQ,CAAEC,SAAS,CAAG,EAAE,CAAEC,MAAM,CAAEC,KAAK,CAAG,CAAE,CAAC,GAAK,CAClF,KAAM,CAACC,oBAAoB,CAAEC,uBAAuB,CAAC,CAAGX,QAAQ,CAAC,KAAK,CAAC,CAEvED,SAAS,CAAC,IAAM,CACd,KAAM,CAAAa,UAAU,CAAGC,MAAM,CAACC,UAAU,CAAC,kCAAkC,CAAC,CACxEH,uBAAuB,CAACC,UAAU,CAACG,OAAO,CAAC,CAE3C,KAAM,CAAAC,OAAO,CAAIC,KAA